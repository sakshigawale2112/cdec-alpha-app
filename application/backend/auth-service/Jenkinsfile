pipeline {
    agent {
        label 'ecs2'
    }

    environment {
        EKS_CLUSTER = 'cdec-eks-dev'
        EKS_REGION = 'eu-north-1'
    }

    stages {

        stage('Checkout') {
            steps {
                git(
                    url: 'https://github.com/sakshigawale2112/cdec-alpha-app.git',
                    branch: 'main'
                )
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('application/backend/auth-service') {
                    sh '''
                        docker build -t 503891328279.dkr.ecr.eu-north-1.amazonaws.com/cdec-alpha-auth:latest .
                    '''
                }
            }
        }

        stage('Push to ECR') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-creds',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    sh '''
                        aws ecr get-login-password --region eu-north-1 | \
                        docker login \
                        --username AWS \
                        --password-stdin 503891328279.dkr.ecr.eu-north-1.amazonaws.com

                        docker push 503891328279.dkr.ecr.eu-north-1.amazonaws.com/cdec-alpha-auth:latest
                    '''
                }
            }
        }

        stage('Deploy to EKS') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-creds',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    dir('application/backend/auth-service') {
                        sh '''
                            aws eks update-kubeconfig \
                            --region eu-north-1 \
                            --name cdec-eks-dev

                            kubectl apply \
                            -f k8s/deployment.yml \
                            -n default

                            kubectl rollout restart \
                            deployment/auth-service \
                            -n default

                            kubectl rollout status \
                            deployment/auth-service \
                            -n default \
                            --timeout=300s
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Auth service deployed successfully!'
        }

        failure {
            echo 'Auth service deployment failed.'
        }
    }
}
